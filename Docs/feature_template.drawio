        <mxCell id="jg5QH8RGZlHhSrdQyCiC-178" value="Сначала отправляется первое сообщение о информации о поиске: текст поиска, кол-во, и т. д." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;" vertex="1" parent="jg5QH8RGZlHhSrdQyCiC-173">
