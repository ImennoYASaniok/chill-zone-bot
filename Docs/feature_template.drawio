        <mxCell id="jg5QH8RGZlHhSrdQyCiC-140" value="текст предсказания&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;тип: грустное/весёлое/злое...&lt;/div&gt;&lt;div&gt;редкость: обычное/редкое/эпическое/легендарное&lt;br&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="jg5QH8RGZlHhSrdQyCiC-139">
