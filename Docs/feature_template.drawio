        <mxCell id="jg5QH8RGZlHhSrdQyCiC-134" value="сохранить / сохранить дубликат" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" vertex="1" parent="jg5QH8RGZlHhSrdQyCiC-133">
